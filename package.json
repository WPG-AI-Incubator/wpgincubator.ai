{
  "name": "wpg-ai-incubator-site",
  "version": "1.0.0",
  "description": "wpgincubator.ai: the WPG AI Incubator website. Plain Node, no framework, no build step.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js",
    "test:browser": "node test/browser/run.mjs",
    "test:all": "npm test && npm run test:browser",
    "build:images": "node scripts/build-images.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.10.0",
    "html-validate": "^9.0.0",
    "playwright": "^1.48.0"
  }
}
