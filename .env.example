# Every setting is optional. With none of them the site still runs:
# Issues come from content/issues.json, Find your room answers by keyword,
# and the page shows email and Eventbrite links instead of forms.
# Copy to .env for local runs; on a host, set these as environment variables.

# --- Basics ---
PORT=3000
# The public address, used in links, the sitemap and link previews.
SITE_URL=https://www.wpgincubator.ai
# How many proxies sit in front of the app (most hosts: 1). Used for rate limits only.
TRUST_PROXY=1

# --- Issues from Eventbrite (dates, links and the agenda update themselves) ---
# A private token from the API keys page of the Eventbrite account that owns the events.
EVENTBRITE_TOKEN=
# The organization that owns the events. See README, "Find the organization id".
EVENTBRITE_ORG_ID=
# Only events with these words in the title are shown.
EVENTBRITE_TITLE_FILTER=incubator
EVENTBRITE_REFRESH_MINUTES=15

# --- Find your room, answered by AI ---
# A Claude API key, made in the Claude Console. Without it, replies are matched by keyword.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# At most this many AI replies a day. Past it, replies are matched by keyword.
FIND_ROOM_DAILY_CAP=500

# --- Forms (each appears only when it has somewhere to send what it collects) ---
# A URL that accepts a JSON POST: your list tool, an automation, a spreadsheet script.
SUBSCRIBE_WEBHOOK_URL=
APPLY_WEBHOOK_URL=
# Or append to files in DATA_DIR. Needs a disk that survives restarts.
FORMS_FILE_STORE=0
DATA_DIR=./data

# --- Analytics (off unless set) ---
# The current site uses G-CGCZPS611C.
GA_MEASUREMENT_ID=
